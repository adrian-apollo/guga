[sub_resource type="GDScript" id="GDScript_g7b7a"]
script/source = "extends Button

@export_file( &\"*.tscn\" ) var level_scene:String
var tree:GugaTree

func _init():
	tree = Engine.get_main_loop()

func _pressed():
	if level_scene.is_empty():
		return
	if !ResourceLoader.exists( level_scene ):
		return
	
	var newl_level:Level = tree.load_level( level_scene )
	tree.change_to_level( newl_level )
"

