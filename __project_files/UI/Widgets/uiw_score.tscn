[sub_resource type="GDScript" id="GDScript_8olry"]
script/source = "extends Label

var tree:GugaTree

func _ready():
	tree = Engine.get_main_loop()
	if !tree.current_level.game_mode.controllers.size():
		return
	
	tree.current_level.game_mode.controllers[0].player_state.score_changed.connect( update )
	
func update( value:float ):
	text = str( int( value ))
"

