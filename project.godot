; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="guga_development"
run/main_scene="uid://bdrydfb6si7ff"
run/main_loop_type="GugaTree"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

Logging="*uid://dyiilh7p87kre"
EnhancedInput="*uid://di122jbxf8vf7"

[display]

window/size/viewport_width=640
window/size/viewport_height=294
window/size/mode=4
window/size/resizable=false
window/size/borderless=true
window/size/extend_to_title=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/enhanced_input/plugin.cfg", "res://addons/gameplay_tags/plugin.cfg", "res://addons/git_console/plugin.cfg", "res://addons/guga/plugin.cfg")

[file_customization]

folder_colors={
"res://__project_files/": "blue",
"res://addons/": "purple",
"res://addons/guga/": "green",
"res://addons/guga/Documentation/": "yellow"
}

[input]

ArrowLeft={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194319,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
ArrowRight={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194321,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
Fire={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
