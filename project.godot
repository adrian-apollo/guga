; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="guga_development"
run/main_scene="uid://bdrydfb6si7ff"
run/main_loop_type="GugaTree"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Logging="*uid://dyiilh7p87kre"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_private_class_variable=0

[display]

window/size/resizable=false
window/size/extend_to_title=true
window/size/maximize_disabled=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gameplay_tags/plugin.cfg", "res://addons/git_console/plugin.cfg", "res://addons/guga/plugin.cfg", "res://addons/logging/plugin.cfg")

[file_customization]

folder_colors={
"res://_gamefiles/": "blue",
"res://addons/": "purple",
"res://addons/guga/": "green",
"res://addons/guga/Documentation/": "yellow"
}

[input]

ArrowLeft={
