script/source = "extends UIWidgetBase

@export var button:Button

func _ready():
	if button:
		button.pressed.connect( pause, 2 )
	
func pause():
	tree.get_gamemode().uis[ 0 ].add_widget_to_layer( load(\"uid://dhhdwjae0gdb\").instantiate(), \"game_menus\")
"

