[gd_scene format=3 uid="uid://dhhdwjae0gdb"]

[sub_resource type="GDScript" id="GDScript_6c8fl"]
script/source = "extends UIWidgetBase

@export var resume:Button
@export var exit:Button

func _ready():
	if resume:
		resume.pressed.connect( resume_game, 4 )
	if exit:
		exit.pressed.connect(exit_game, 4)

func resume_game():
	queue_free()

func exit_game():
	tree.quit()
	
"

